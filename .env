# ── Solace PubSub+ Connection (VITE_ prefix required for client-side exposure) ──
VITE_SOLACE_URL=ws://localhost:8008
VITE_SOLACE_VPN=default
VITE_SOLACE_USERNAME=default
VITE_SOLACE_PASSWORD=default

# ── Application Topics ──────────────────────────────────────────────────────
# Topic the MRI scanner console publishes its live video frames to.
VITE_VIDEO_TOPIC=gehc/mri/scanner/feed
# Topic for scanner status / analytics messages.
VITE_STATUS_TOPIC=gehc/mri/scanner/status

# ── Demo Mode ───────────────────────────────────────────────────────────────
# Set to 'true' to run without a Solace broker (frames are simulated locally).
VITE_DEMO_MODE=false

# ── Session ID ──────────────────────────────────────────────────────────────
# When 'true', a UUID is appended to the video topic and a QR code is shown so a
# remote reading station can subscribe to this specific scanner's feed.
VITE_SESSION_ID_ENABLED=true
